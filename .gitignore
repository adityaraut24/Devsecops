# =============================================================================
# Git Ignore Configuration
# Project: Hospital Queue Management System
# =============================================================================

# Dependency directories
node_modules/
jspm_packages/

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data & PIDs
pids/
*.pid
*.seed
*.pid.lock

# Production build outputs
dist/
dist-ssr/
build/
*.local

# Environment variables & secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.pub
*.id_rsa
*.id_ed25519

# Terraform Local State & Variables
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Trivy Security Scans & Reports
trivy-*.json
trivy-*.txt
trivy-*.html
scan-results/

# SonarQube & Code Coverage
.scannerwork/
coverage/

# Editor and OS files
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated files and local secrets
node_modules/
dist/
.env
.env.*
!.env.example
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
reports/
